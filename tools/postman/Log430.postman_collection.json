        {
          "name": "Get stock magasin 1",
          "request": { "method": "GET", "url": "{{lab2_base}}/api/v1/stores/1/stock" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('has stock', function () { pm.expect(json).to.have.property('stock'); });"
